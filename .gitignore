# Machine-specific keys and paths: only the example is shared.
.env
.env.*
!.env.example
# Personal Claude Code permissions and settings.
.claude/settings.local.json
data/
__pycache__/
*.pyc
.venv/
node_modules/
.pytest_cache/
.ruff_cache/
*.egg-info/
app/dist/
app/src-tauri/target/
