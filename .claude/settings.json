{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/gamestudio context session 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
