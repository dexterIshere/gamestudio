# The studio's key: look (images, concepts) and meshes through Runware.
# https://my.runware.ai/keys
RUNWARE_API_KEY=

# Optional: the direct Tripo API, for the models Runware does not host (P2 and
# its native quads, the H family, dedicated texturing). Without it the whole
# studio works and only this path is refused.
# https://platform.tripo3d.ai
TRIPO_API_KEY=

# Studio root when working from a game folder: set it in the environment (the MCP server's `env`), never here.
# GAMESTUDIO_HOME=/path/to/gamestudio

# Studio data (project registry, hosted projects, token); a project keeps its own in its `.gamestudio/`.
GAMESTUDIO_DATA_DIR=./data

# Agent notes (`context/`) and inbox (`inbox/`) outside the studio root: for tests.
# GAMESTUDIO_CONTEXT_DIR=
# GAMESTUDIO_INBOX_DIR=

# Blender binary (headless). Must be >= 4.2
BLENDER_BIN=blender

# Local API. 8080 is often taken on a dev machine; change it if needed.
GAMESTUDIO_API_HOST=127.0.0.1
GAMESTUDIO_API_PORT=7788
