{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gamestudio",
  "version": "0.3.0",
  "identifier": "dev.gamestudio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "gamestudio",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0f0d0b",
        "create": false
      },
      {
        "label": "chat",
        "title": "gamestudio — chats",
        "url": "chat.html",
        "width": 640,
        "height": 900,
        "minWidth": 520,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "visible": true,
        "theme": "Dark",
        "backgroundColor": "#0f0d0b",
        "create": false
      },
      {
        "label": "update",
        "title": "gamestudio — update",
        "url": "update.html",
        "width": 560,
        "height": 400,
        "minWidth": 480,
        "minHeight": 340,
        "resizable": true,
        "center": true,
        "decorations": false,
        "visible": true,
        "create": false,
        "theme": "Dark",
        "backgroundColor": "#0f0d0b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:*; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
